{
  "schema_version": 1,
  "approval_status": "candidate-defaults",
  "precedence": [
    "live_runtime_limit",
    "user_approved_limit",
    "risk_specific_limit",
    "class_default"
  ],
  "classes": {
    "direct": {
      "max_subagents": 0,
      "max_retries_per_task": 1,
      "max_tokens": 40000,
      "max_elapsed_seconds": 1800,
      "max_cost_usd": 3.0,
      "verification_reserve": 0
    },
    "scout-assisted": {
      "max_subagents": 2,
      "max_retries_per_task": 2,
      "max_tokens": 80000,
      "max_elapsed_seconds": 3600,
      "max_cost_usd": 6.0,
      "verification_reserve": 0
    },
    "multi-workstream": {
      "max_subagents": 4,
      "max_active_fraction": 0.75,
      "max_retries_per_task": 2,
      "max_tokens": 160000,
      "max_elapsed_seconds": 7200,
      "max_cost_usd": 15.0,
      "verification_reserve": 1
    }
  },
  "risk_tiers": {
    "R0": {
      "independent_verifier_required": false
    },
    "R1": {
      "independent_verifier_required": false
    },
    "R2": {
      "independent_verifier_required": true
    },
    "R3": {
      "independent_verifier_required": true,
      "explicit_authority_required": true
    }
  },
  "stop_conditions": [
    "required result is proven and remaining work cannot change the verdict",
    "approved token, time, retry, or agent budget is exhausted",
    "the same hypothesis failed without new evidence",
    "continuation would violate scope, ownership, or authorization",
    "progress requires external state or a user decision"
  ]
}
