{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ricardoakinaga-dev/orchestrate/schemas/orchestration-state.schema.json",
  "title": "Orchestrate state ledger",
  "type": "object",
  "required": ["schema_version", "goal", "contracts", "limits", "evidence_registry", "tasks"],
  "properties": {
    "schema_version": {"const": 3},
    "goal": {"type": "string", "minLength": 1},
    "contracts": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "limits": {
      "type": "object",
      "required": ["max_attempts_per_task", "max_checkpoint_age_seconds"],
      "properties": {
        "max_attempts_per_task": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_checkpoint_age_seconds": {"type": "integer", "minimum": 30, "maximum": 3600}
      },
      "additionalProperties": false
    },
    "evidence_registry": {
      "type": "object",
      "propertyNames": {"pattern": "^sha256:[0-9a-f]{64}$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["check", "result", "summary", "artifact", "integrity", "contract_integrity", "manifest", "manifest_integrity", "current"],
      "properties": {
        "check": {"type": "string", "minLength": 1},
        "result": {"enum": ["PASS", "FAIL", "NOT RUN"]},
        "summary": {"type": "string", "minLength": 1},
        "artifact": {"type": ["string", "null"]},
        "integrity": {"type": ["string", "null"]},
        "contract_integrity": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "manifest": {"type": ["string", "null"]},
        "manifest_integrity": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "current": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["id", "required", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
        "required": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": ["number", "outcome", "hypothesis_id", "hypothesis", "evidence_delta", "evidence_refs"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "outcome": {"type": "string", "minLength": 1},
        "hypothesis_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
        "hypothesis": {"type": "string", "minLength": 1},
        "evidence_delta": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["severity", "summary"],
      "properties": {
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["id", "status", "dependencies", "owns", "contracts", "criteria", "attempts", "history", "open_findings"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
        "status": {"enum": ["PENDING", "READY", "RUNNING", "IMPLEMENTED", "REVIEW", "REWORK", "VERIFIED", "DONE", "BLOCKED", "FAILED"]},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "owns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "contracts": {"type": "object", "additionalProperties": {"type": "string"}},
        "criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}},
        "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
        "history": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "open_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "blocked_on": {"type": "string", "minLength": 1},
        "execution": {"$ref": "#/$defs/execution"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "RUNNING"}}, "required": ["status"]},
          "then": {"required": ["execution"]},
          "else": {"not": {"required": ["execution"]}}
        },
        {
          "if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]},
          "then": {"required": ["blocked_on"]},
          "else": {"not": {"required": ["blocked_on"]}}
        }
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["process_id", "process_start_token", "observed_at", "checkpoint_generation", "workspace_fingerprint", "artifact_fingerprint", "observer"],
      "properties": {
        "process_id": {"type": "integer", "minimum": 1},
        "process_start_token": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "checkpoint_generation": {"type": "integer", "minimum": 1},
        "workspace_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifact_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "observer": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
